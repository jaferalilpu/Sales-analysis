# Test Environment Variables
NODE_ENV=test

# Database - Test PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ulica_test?schema=public"

# JWT Configuration
JWT_SECRET="test-jwt-secret-key-for-testing-only"
JWT_REFRESH_SECRET="test-jwt-refresh-secret-key-for-testing-only"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay Test Keys
RAZORPAY_KEY_ID="rzp_test_00000000000000"
RAZORPAY_KEY_SECRET="test_secret_key"

# Email Configuration (Test)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER="test@example.com"
SMTP_PASS="test_password"
FROM_EMAIL="noreply@ulica.test"

# NextAuth Configuration
NEXTAUTH_SECRET="test-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL="error"
