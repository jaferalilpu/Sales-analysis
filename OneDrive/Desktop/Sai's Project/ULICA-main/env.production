# Production Environment Variables for AWS Deployment
NODE_ENV=production

# Database - AWS RDS PostgreSQL
DATABASE_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/ulica_production

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production-ulica-2024
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-change-this-in-production-ulica-2024
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Frontend
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PhonePe
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_ENVIRONMENT=production

# Shiprocket
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_WAREHOUSE_ID=your-warehouse-id

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=ULICA

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ulica-production-uploads
AWS_S3_DOMAIN=your-s3-bucket.s3.ap-south-1.amazonaws.com

# CloudFront CDN (optional)
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Redis Configuration (if using ElastiCache)
REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379

# Analytics
GOOGLE_ANALYTICS_ID=your-ga-id
NEXT_PUBLIC_GA_ID=your-ga-id

# Security
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production
NEXTAUTH_URL=https://your-domain.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
